# --- Telegram ---
BOT_TOKEN=123456:AA...
# Публичный https-адрес сервиса; вебхук будет выставлен на $WEBHOOK_BASE/tg/$WEBHOOK_SECRET
WEBHOOK_BASE=https://bot.example.uz
# Произвольная случайная строка: и путь вебхука, и значение X-Telegram-Bot-Api-Secret-Token
WEBHOOK_SECRET=change-me-to-a-long-random-string
# Telegram id администраторов через запятую — им доступны /stats и /grant
ADMIN_IDS=123456789

# --- Claude API ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-4-5
CLAUDE_MAX_TOKENS=1000
CLAUDE_TEMPERATURE=0.2
CLAUDE_TIMEOUT_SECONDS=30
# Цены API, USD за 1 млн токенов (см. platform.claude.com/docs/en/about-claude/pricing)
CLAUDE_INPUT_PRICE_PER_MTOK=1.0
CLAUDE_OUTPUT_PRICE_PER_MTOK=5.0

# --- Инфраструктура ---
DATABASE_URL=postgresql+asyncpg://excelbot:excelbot@db:5432/excelbot
REDIS_URL=redis://redis:6379/0
SENTRY_DSN=
LOG_LEVEL=INFO

# --- Тарифы и лимиты ---
FREE_MONTHLY_LIMIT=10
PRO_MONTHLY_LIMIT=300
PRO_PRICE_UZS=29000
RATE_LIMIT_PER_MINUTE=5
MAX_INPUT_CHARS=1000

# --- Эквайринг ---
# Провайдер оплаты ещё не подключён: /pay показывает сообщение «скоро».
# Когда появится договор с Payme — PAYMENT_PROVIDER=payme и ключи мерчанта.
PAYMENT_PROVIDER=disabled
SUPPORT_CONTACT=@your_support_username
