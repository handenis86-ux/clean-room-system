# Search Console site URL
# Если у вас URL-prefix property — нужен слэш в конце:
#   GSC_SITE_URL=https://cleanroom.uz/
# Если Domain property (рекомендую) — формат sc-domain:
#   GSC_SITE_URL=sc-domain:cleanroom.uz
GSC_SITE_URL=sc-domain:cleanroom.uz

# Тот же путь к Service Account JSON, что и в ga/.env
GOOGLE_APPLICATION_CREDENTIALS=D:\projects\CRS\.secrets\crs-analytics-sa.json
