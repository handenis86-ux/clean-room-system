# GA4 Property ID — numeric ID, NOT measurement ID (G-XXX)
# Найти: GA4 → Admin → Property Settings → Property ID
GA_PROPERTY_ID=000000000

# Path to Google Cloud Service Account JSON key
# Скачивается из Google Cloud Console → IAM & Admin → Service Accounts → Keys
GOOGLE_APPLICATION_CREDENTIALS=D:\projects\CRS\.secrets\crs-analytics-sa.json
